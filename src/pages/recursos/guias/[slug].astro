---
import pageContent from '../../../../content/pages.json';
const copy = pageContent['pages-recursos-guias-slug'];
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import { guides } from '../../../data/guides';
import { solutions } from '../../../data/solutions';
import '../../../styles/solutions.css';
import '../../../styles/resources.css';
export function getStaticPaths() { return guides.map(guide => ({ params: { slug: guide.slug }, props: { guide } })); }
const { guide } = Astro.props;
---
<Layout title={`${guide.title} · Sistematicando`} description={guide.intro}>
  <Header /><main id="contenido" tabindex="-1">
    <article class="wrap guide-article">
      <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">{copy.text_001}</a><span aria-hidden="true">/</span><a href="/recursos/">{copy.text_002}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.text_003}</span></nav>
      <header class="guide-heading"><p class="eyebrow">{guide.category} · Guía práctica</p><h1>{guide.title}</h1><p class="solution-intro">{guide.intro}</p><p class="resource-note">{copy.text_004}</p></header>
      <div class="guide-content"><aside class="guide-toc"><nav aria-label="Contenido de la guía"><h2>{copy.text_005}</h2><ol>{guide.sections.map((section,index) => <li><a href={`#paso-${index+1}`}>{section.title.replace(/^\d+\. /,'')}</a></li>)}</ol></nav></aside><div class="guide-body">{guide.sections.map((section,index) => <section id={`paso-${index+1}`}><h2>{section.title}</h2>{section.paragraphs.map(text => <p>{text}</p>)}<ul class="guide-checklist">{section.checklist.map(text => <li>{text}</li>)}</ul></section>)}<section class="guide-takeaway" aria-labelledby="takeaway-title"><h2 id="takeaway-title">{copy.text_006}</h2><p>{guide.takeaway}</p></section></div></div>
    </article>
    <section class="wrap resources-section"><p class="eyebrow">{copy.text_007}</p><h2>{copy.text_008}</h2><nav class="related-topics" aria-label="Soluciones relacionadas">{guide.related.map(slug => <a href={`/soluciones/${slug}/`}>{solutions.find(solution => solution.slug === slug)?.name}</a>)}</nav><p class="resource-note">{copy.text_009} <a href={`/funcionalidades/#${guide.feature}`}>{copy.text_010}</a> {copy.text_011}</p><div class="commercial-links"><a class="text-link" href="/recursos/">{copy.text_012} <Icon /></a><a class="text-link" href="/solicitar-demo/">{copy.text_013} <Icon /></a></div></section>
  </main><Footer />
</Layout>
