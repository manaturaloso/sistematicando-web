---
import pageContent from '../../../content/pages.json';
const copy = pageContent['pages-recursos-index'];
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { guides } from '../../data/guides';
import '../../styles/solutions.css';
import '../../styles/resources.css';
---
<Layout title={copy.seo_title} description={copy.seo_description}>
  <Header /><main id="contenido" tabindex="-1">
    <section class="wrap solution-hero"><nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">{copy.text_001}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.text_002}</span></nav><p class="eyebrow">{copy.text_003}</p><h1>{copy.text_004}<br /><em>{copy.text_005}</em></h1><p class="solution-intro">{copy.text_006}</p></section>
    <section class="wrap resources-section" aria-labelledby="guides-title"><h2 id="guides-title">{copy.text_007}</h2><div class="guide-grid">{guides.map(guide => <article class="guide-card"><p class="eyebrow">{guide.category}</p><h3><a href={`/recursos/guias/${guide.slug}/`}>{guide.title}</a></h3><p>{guide.intro}</p><a class="text-link" href={`/recursos/guias/${guide.slug}/`} aria-label={`Leer guía: ${guide.title}`}>{copy.text_008} <Icon /></a></article>)}</div><p class="resource-note">{copy.text_009}</p></section>
    <section class="wrap resources-section" aria-labelledby="explore-title"><h2 id="explore-title">{copy.text_014}</h2><div class="guide-grid"><article class="guide-card"><h3>{copy.text_015}</h3><p>{copy.text_016}</p><a class="text-link" href="/blog/">{copy.text_017}<Icon/></a></article><article class="guide-card"><h3>{copy.text_018}</h3><p>{copy.text_019}</p><a class="text-link" href="/ayuda/">{copy.text_020}<Icon/></a></article></div></section>
    <section class="wrap solution-callout"><div><p class="eyebrow">{copy.text_010}</p><h2>{copy.text_011}</h2></div><div><p>{copy.text_012}</p><a class="text-link" href="/preguntas-frecuentes/">{copy.text_013} <Icon /></a></div></section>
  </main><Footer />
</Layout>
