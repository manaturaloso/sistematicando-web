---
import pageContent from '../../content/pages.json';
const copy = pageContent['pages-404'];
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title={copy.seo_title} description={copy.seo_description}><main id="contenido" tabindex="-1" class="wrap section error-page"><p class="eyebrow">{copy.text_001}</p><h1>{copy.text_002}</h1><p>{copy.text_003}</p><nav class="error-links" aria-label={copy.text_006}><a class="button" href="/">{copy.text_004} <Icon /></a><a class="text-link" href="/ayuda/">{copy.text_005} <Icon /></a></nav></main></Layout>
