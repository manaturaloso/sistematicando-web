---
import pageContent from '../../../content/pages.json';
import terms from '../../../content/terms.json';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {contact,whatsappUrl} from '../../data/contact';
import '../../styles/solutions.css';
import '../../styles/commercial.css';
const copy=pageContent['pages-legal-terminos'];
const responsible=copy.text_007.replace('{responsible}',contact.responsible).replace('{ruc}',contact.ruc).replace('{address}',contact.address);
---
<Layout title={copy.seo_title} description={copy.seo_description}>
  <Header/><main id="contenido" tabindex="-1" class="wrap privacy-page">
    <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">{copy.text_001}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.text_002}</span></nav>
    <p class="eyebrow">{copy.text_003}</p><h1>{copy.text_004}</h1><p class="scope-note">{copy.text_005}</p>
    <section aria-labelledby="responsable"><h2 id="responsable">{copy.text_006}</h2><p>{responsible}</p></section>
    <nav class="legal-toc" aria-label={copy.text_008}><h2>{copy.text_008}</h2><ol role="list">{terms.sections.map(section=><li><a href={`#${section.id}`}>{section.title}</a></li>)}</ol></nav>
    {terms.sections.map(section=><section id={section.id} class="legal-section" aria-labelledby={`${section.id}-title`}><h2 id={`${section.id}-title`}>{section.title}</h2>{section.paragraphs.map(text=><p>{text}</p>)}</section>)}
    <section id="contacto-legal" aria-labelledby="contacto-title"><h2 id="contacto-title">{copy.text_009}</h2><p>{copy.text_010} <a href={`mailto:${contact.email}`}>{contact.email}</a>.</p><div class="commercial-links"><a href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener noreferrer">{copy.text_011} {copy.text_014}</a><a href={whatsappUrl} target="_blank" rel="noopener noreferrer">{copy.text_012} {copy.text_014}</a><a href={contact.privacyPath}>{copy.text_013}</a></div><p>{copy.text_015}</p></section>
  </main><Footer/>
</Layout>
