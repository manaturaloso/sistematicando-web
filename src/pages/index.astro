---
import structuredContent from '../../content/home.json';
import pageContent from '../../content/pages.json';
const copy = pageContent['pages-index'];
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Header from '../components/Header.astro';
import ProductConcept from '../components/ProductConcept.astro';
import Footer from '../components/Footer.astro';
import FAQList from '../components/FAQList.astro';
import { faqs } from '../data/faqs';
const sectors = structuredContent.sectors;

---
<Layout>
  <Header />
  <main id="contenido" tabindex="-1">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy"><p class="eyebrow"><span class="coral-dot"></span> {copy.text_001}</p><h1 id="hero-title">{copy.text_002}<br /><em>{copy.text_003}</em></h1><p class="hero-description">{copy.text_004}</p><div class="hero-actions"><a class="button" href="#propuesta">{copy.text_005} <Icon /></a><a class="text-link" href="#sectores">{copy.text_006} <span aria-hidden="true">↓</span></a></div><p class="hero-note">{copy.text_007}</p></div>
      <div class="hero-visual"><div class="visual-orbit" aria-hidden="true"></div><span class="visual-note">{copy.text_008}</span><ProductConcept /></div>
    </section>
    <div class="industry-strip"><div class="wrap"><span>{copy.text_009}<br /><strong>{copy.text_010}</strong></span><p>{copy.text_011} <i>·</i> {copy.text_012} <i>·</i> {copy.text_013} <i>·</i> {copy.text_014} <i>·</i> {copy.text_015}</p></div></div>
    <section id="propuesta" class="section wrap problem"><div><p class="eyebrow">{copy.text_016}</p><h2>{copy.text_017}<br />{copy.text_018}<br /><span class="muted">{copy.text_019}</span></h2></div><div class="problem-copy"><p class="large-copy">{copy.text_020}</p><p>{copy.text_021}</p><p>{copy.text_022}</p><a class="text-link" href="#ecosistema">{copy.text_023} <Icon /></a></div></section>
    <section id="ecosistema" class="ecosystem section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{copy.text_024}</p><h2>{copy.text_025}<br />{copy.text_026}</h2></div><p>{copy.text_027}</p></div><div class="ecosystem-grid"><article class="ecosystem-feature"><span class="feature-icon"><Icon name="grid" /></span><h3>{copy.text_028}<br />{copy.text_029}</h3><p>{copy.text_030}</p><span class="pill">{copy.text_031}</span></article><div class="module-list">{structuredContent.modules.map(({n,title,text}) => <article class="module"><span>{n}</span><div><h3>{title}</h3><p>{text}</p></div><Icon /></article>)}</div></div><a class="text-link" href="/funcionalidades/">{copy.text_032} <Icon /></a></div></section>
    <section id="sectores" class="section wrap"><div class="section-heading"><div><p class="eyebrow">{copy.text_033}</p><h2>{copy.text_034}<br />{copy.text_035}</h2></div><p>{copy.text_036}</p></div><div class="sector-grid">{sectors.map(sector => <article class="sector"><div class="sector-top"><span class="eyebrow">{sector.n}</span><span class="sector-symbol"><Icon name={sector.symbol} /></span></div><h3><a href={sector.slug ? `/soluciones/${sector.slug}/` : '/soluciones/'}>{sector.title}</a></h3><p>{sector.text}</p><span class="sector-tags">{sector.tags}</span></article>)}</div><p class="section-note">{copy.text_037}</p></section>
    <section class="modularity wrap"><div><p class="eyebrow">{copy.text_038}</p><h2>{copy.text_039}<br />{copy.text_040}</h2></div><div><p>{copy.text_041}</p><p>{copy.text_042}</p><a class="text-link" href="/precios/">{copy.text_043} <Icon /></a></div></section>
    <section id="preguntas" class="section wrap faq-section"><div><p class="eyebrow">{copy.text_044}</p><h2>{copy.text_045}<br />{copy.text_046}</h2><p>{copy.text_047}</p></div><div><FAQList items={faqs.filter(item => item.home)} /><a class="text-link" href="/preguntas-frecuentes/">{copy.text_048}</a><a class="text-link" href="/recursos/">{copy.text_049}</a></div></section>
    <section id="conversemos" class="wrap contact-section"><div class="contact-copy"><p class="eyebrow">{copy.text_050}</p><h2>{copy.text_051}<br />{copy.text_052}</h2><p>{copy.text_053}</p><p class="contact-status"><span class="status-dot"></span> {copy.text_054}</p></div><div class="demo-preparation"><h3>{copy.text_055}</h3><ol><li><strong>{copy.text_056}</strong><span>{copy.text_057}</span></li><li><strong>{copy.text_058}</strong><span>{copy.text_059}</span></li><li><strong>{copy.text_060}</strong><span>{copy.text_061}</span></li></ol><p>{copy.text_062}</p><a class="text-link" href="/solicitar-demo/">{copy.text_063} <span aria-hidden="true">↑</span></a></div></section>
  </main>
  <Footer />
</Layout>
