---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Header from '../components/Header.astro';
import ProductConcept from '../components/ProductConcept.astro';
import Footer from '../components/Footer.astro';
const sectors = [
  { slug: 'restaurantes', n: '01', title: 'Restaurantes', text: 'Del primer pedido al cierre del día. Piensa en una operación donde salón, cocina y administración se entiendan.', tags: 'Mesas · Comandas · Caja', symbol: 'arrow' },
  { slug: 'cafeterias', n: '02', title: 'Cafeterías', text: 'Cada detalle hace la diferencia: la atención, las recetas y los insumos que acompañan cada taza.', tags: 'Atención · Recetas · Insumos', symbol: 'cup' },
  { slug: 'bares', n: '03', title: 'Bares', text: 'Una buena noche también necesita orden detrás de la barra. Conecta las necesidades de atención y control.', tags: 'Barra · Pedidos · Inventario', symbol: 'sparkle' },
  { slug: '', n: '04', title: 'Más formas de crecer', text: 'Hoteles, eventos o varias sedes. Cada operación merece una evaluación de su alcance y sus necesidades.', tags: 'Hospitalidad · Eventos · Multisede', symbol: 'arrow' },
];
const questions = [
  ['¿Qué es Sistematicando?', 'Es una propuesta de plataforma de gestión empresarial para conectar distintas áreas de negocios de gastronomía, hospitalidad y eventos. Esta web está en desarrollo y el alcance comercial de sus módulos todavía debe verificarse.'],
  ['¿Todas las funciones están disponibles?', 'No se ha confirmado la disponibilidad de los módulos en esta versión del sitio. Las áreas y visuales presentados explican la propuesta de producto; no son una garantía de funciones contratables.'],
  ['¿Puedo usarlo si tengo más de un local?', 'La gestión de varias sedes forma parte de la propuesta. Antes de recomendar una solución, hace falta revisar la estructura del negocio y confirmar el alcance real del producto.'],
  ['¿Cuánto cuesta?', 'Aún no hay una tabla de precios aprobada para publicar. No presentamos tarifas ni condiciones contractuales provisionales como oficiales.'],
  ['¿Cómo solicito una demostración?', 'El canal de atención todavía está por configurar. Puedes revisar la sección de preparación para una demo; esta web no envía solicitudes ni recoge datos personales por ahora.'],
];
---
<Layout>
  <Header />
  <main id="contenido">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy"><p class="eyebrow"><span class="coral-dot"></span> Menos dispersión. Más claridad.</p><h1 id="hero-title">Todo tu negocio,<br /><em>bajo control.</em></h1><p class="hero-description">Tu negocio tiene muchas piezas. Nuestra propuesta es ayudarte a verlas como un todo: ventas, operación y gestión, en un mismo ecosistema.</p><div class="hero-actions"><a class="button" href="#propuesta">Conoce la propuesta <Icon /></a><a class="text-link" href="#sectores">Encuentra tu negocio <span aria-hidden="true">↓</span></a></div><p class="hero-note">Pensado para quienes están detrás de cada gran experiencia.</p></div>
      <div class="hero-visual"><div class="visual-orbit" aria-hidden="true"></div><span class="visual-note">Cada pieza, en su lugar.</span><ProductConcept /></div>
    </section>
    <div class="industry-strip"><div class="wrap"><span>Un día a día distinto.<br /><strong>Una misma necesidad de orden.</strong></span><p>Restaurantes <i>·</i> Cafeterías <i>·</i> Bares <i>·</i> Hospitalidad <i>·</i> Eventos</p></div></div>
    <section id="propuesta" class="section wrap problem"><div><p class="eyebrow">01 / Una forma de verlo mejor</p><h2>Tu negocio ya tiene<br />suficientes piezas.<br /><span class="muted">Que encajen mejor.</span></h2></div><div class="problem-copy"><p class="large-copy">Una venta por aquí. Un inventario por allá. Y tú, tratando de unir los puntos.</p><p>Sistematicando nace de una idea sencilla: la gestión debería ayudarte a entender lo que pasa, sin obligarte a saltar entre herramientas desconectadas.</p><p>El objetivo es reunir información y procesos para que puedas dedicar más atención a tu equipo, a tus clientes y a lo que viene.</p><a class="text-link" href="#ecosistema">Explora el ecosistema <Icon /></a></div></section>
    <section id="ecosistema" class="ecosystem section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">02 / La visión del producto</p><h2>Todo conectado.<br />Todo más claro.</h2></div><p>Una propuesta modular que parte de tu operación. Estas son las áreas que buscamos conectar; su disponibilidad está pendiente de verificación.</p></div><div class="ecosystem-grid"><article class="ecosystem-feature"><span class="feature-icon"><Icon name="grid" /></span><h3>La operación,<br />en el centro.</h3><p>Desde lo que ocurre frente al cliente hasta lo que necesitas revisar al terminar el día.</p><span class="pill">Visión de producto</span></article><div class="module-list">{[['01','Ventas y atención','Pedidos, caja y coordinación del servicio.'],['02','Inventario y costos','Productos, insumos y una mejor lectura de los recursos.'],['03','Clientes y reservas','Información útil para acompañar cada visita.'],['04','Equipo y gestión','Personas, sedes e información para decidir.']].map(([n,title,text]) => <article class="module"><span>{n}</span><div><h3>{title}</h3><p>{text}</p></div><Icon /></article>)}</div></div><a class="text-link" href="/funcionalidades/">Explorar las áreas de gestión <Icon /></a></div></section>
    <section id="sectores" class="section wrap"><div class="section-heading"><div><p class="eyebrow">03 / Tu forma de trabajar</p><h2>Cada negocio<br />tiene su propio ritmo.</h2></div><p>No todos los negocios necesitan lo mismo. Empezamos por entender qué ocurre en el tuyo.</p></div><div class="sector-grid">{sectors.map(sector => <article class="sector"><div class="sector-top"><span class="eyebrow">{sector.n}</span><span class="sector-symbol"><Icon name={sector.symbol} /></span></div><h3><a href={sector.slug ? `/soluciones/${sector.slug}/` : '/soluciones/'}>{sector.title}</a></h3><p>{sector.text}</p><span class="sector-tags">{sector.tags}</span></article>)}</div><p class="section-note">Áreas de aplicación propuestas. El alcance para cada sector se confirma antes de cualquier contratación.</p></section>
    <section class="modularity wrap"><div><p class="eyebrow">A tu medida, paso a paso</p><h2>Primero, lo que necesitas.<br />Después, lo que sigue.</h2></div><div><p>La visión es modular: definir una base adecuada para tu negocio y evaluar nuevas necesidades a medida que creces.</p><p>Sin una lista interminable de promesas. Con una conversación clara sobre el alcance, los módulos y las condiciones.</p><a class="text-link" href="/precios/">Conoce cómo definir el alcance <Icon /></a></div></section>
    <section id="preguntas" class="section wrap faq-section"><div><p class="eyebrow">04 / Hablemos claro</p><h2>Buenas preguntas.<br />Respuestas directas.</h2><p>Lo que conviene saber antes de dar el siguiente paso.</p></div><div class="faq-list">{questions.map(([question,answer]) => <details><summary>{question}<span aria-hidden="true">＋</span></summary><p>{answer}</p></details>)}</div></section>
    <section id="conversemos" class="wrap contact-section"><div class="contact-copy"><p class="eyebrow">El siguiente paso empieza contigo</p><h2>Cuéntanos cómo<br />se mueve tu negocio.</h2><p>Para una futura demostración útil, lo primero es entender qué quieres organizar mejor.</p><p class="contact-status"><span class="status-dot"></span> Canal de atención pendiente de habilitar</p></div><div class="demo-preparation"><h3>Prepara tu próxima conversación</h3><ol><li><strong>Tu operación</strong><span>Tipo de negocio y cantidad de locales.</span></li><li><strong>Tu prioridad</strong><span>Qué proceso te gustaría ordenar primero.</span></li><li><strong>Tu punto de partida</strong><span>Cómo lo gestionas hoy y qué te gustaría mejorar.</span></li></ol><p>Esta versión no recibe solicitudes. Habilitaremos el canal cuando estén confirmados el contacto comercial y la política de privacidad.</p><a class="text-link" href="/solicitar-demo/">Preparar mi guía de demo <span aria-hidden="true">↑</span></a></div></section>
  </main>
  <Footer />
</Layout>
