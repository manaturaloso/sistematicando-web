---
import implementation from '../../../content/implementation.json';
import {pricing,money,moduleInPlan,addonForModule} from '../../data/pricing';
import {features} from '../../data/features';
import {contact} from '../../data/contact';
import pageContent from '../../../content/pages.json';
const copy = pageContent['pages-precios-index'];
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import FAQList from '../../components/FAQList.astro';
import { faqs } from '../../data/faqs';
import '../../styles/solutions.css';
import '../../styles/commercial.css';
const factors=pricing.factors;
const planUrl=(name:string)=>`https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(contact.whatsappMessage+' Me interesa el plan '+name+'.')}`;

---
<Layout title={copy.seo_title} description={copy.seo_description}>
  <Header />
  <main id="contenido" tabindex="-1">
    <section class="wrap solution-hero">
      <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">{copy.text_001}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.text_002}</span></nav>
      <p class="eyebrow">{copy.text_003}</p>
      <h1>{copy.text_004}<br /><em>{copy.text_005}</em></h1>
      <p class="solution-intro">{copy.text_006}</p>
      <aside class="scope-note"><strong>{copy.text_007}</strong><p>{copy.text_008}</p></aside>
      <a class="button commercial-hero-action" href="/solicitar-demo/">{copy.text_009} <Icon /></a>
    </section>
    <section class="wrap pricing-section" aria-labelledby="plans-title"><p class="eyebrow">{copy.text_033}</p><h2 id="plans-title">{copy.text_034}</h2><div class="pricing-grid">{pricing.plans.map(plan=><article id={`plan-${plan.id}`} data-plan={plan.id} class:list={['pricing-card',{'pricing-featured':plan.featured}]}><div class="plan-badge">{plan.featured&&<span>{copy.text_035}</span>}</div><h3>{plan.name}</h3><p class="plan-tagline">{plan.tagline}</p><p class="plan-description">{plan.description}</p><p class="plan-price"><strong>{money(plan.monthlyPrice)}</strong><span>/ {pricing.billingLabel}</span></p><dl class="plan-limits"><div><dt>{copy.text_040}</dt><dd>{plan.locations}</dd></div><div><dt>{copy.text_041}</dt><dd>{plan.users}</dd></div></dl><ul>{plan.highlights.map(item=><li>{item}</li>)}</ul><div class="plan-setup"><p>{copy.text_036}: <strong>{money(plan.setupPrice)}</strong><br/><span>{copy.text_037}</span></p><p class="plan-first-month">{copy.text_038} <strong>{money(plan.monthlyPrice+plan.setupPrice)}</strong><br/><span>{copy.text_039}</span></p></div><a class="button plan-cta" href={planUrl(plan.name)} target="_blank" rel="noopener noreferrer" aria-label={`${copy.text_042}: ${plan.name}`} aria-describedby="plan-action-note">{copy.text_042}<Icon/></a></article>)}</div><p id="plan-action-note" class="pricing-note">{copy.text_043}</p><p class="pricing-note">{pricing.taxNotice}</p><p class="pricing-note">{copy.text_060}</p><a class="text-link" href="#comparar-planes">{copy.text_044}<Icon/></a></section>
    <section id="comparar-planes" class="wrap pricing-section" aria-labelledby="comparison-title"><h2 id="comparison-title">{copy.text_044}</h2><p>{copy.text_050}</p><div class="pricing-table-wrap" role="region" tabindex="0" aria-label={copy.text_051}><table class="pricing-table"><caption>{copy.text_045}</caption><thead><tr><th scope="col">{copy.text_046}</th>{pricing.plans.map(plan=><th scope="col">{plan.name}</th>)}</tr></thead><tbody>{features.map(feature=><tr><th scope="row"><a href={`/funcionalidades/${feature.id}/`}>{feature.name}</a></th>{pricing.plans.map(plan=><td>{moduleInPlan(feature.id,plan.id)?copy.text_047:addonForModule(feature.id,plan.id)?<a href={`#complemento-${addonForModule(feature.id,plan.id)!.id}`}>{copy.text_048}</a>:copy.text_049}</td>)}</tr>)}</tbody></table></div></section>
    <section class="wrap pricing-section" aria-labelledby="addons-title"><p class="eyebrow">{copy.text_052}</p><h2 id="addons-title">{copy.text_053}</h2><div class="pricing-grid pricing-addons">{pricing.addons.map(addon=><article id={`complemento-${addon.id}`} data-addon={addon.id}><h3>{addon.name}</h3><p class="addon-price"><strong>{money(addon.monthlyPrice)}</strong> / {addon.unit}</p><p>{copy.text_054} {addon.planIds.map(id=>pricing.plans.find(plan=>plan.id===id)!.name).join(', ')}.</p><p>{addon.scope}</p></article>)}</div><div class="pricing-service-scope"><article><h3>{copy.text_058}</h3><p>{pricing.setupScope}</p></article><article><h3>{copy.text_059}</h3><p>{pricing.supportScope}</p></article></div><aside class="scope-note"><strong>{copy.text_055}</strong><p>{copy.text_056}</p><a href="/solicitar-demo/">{copy.text_057}</a></aside></section>
    <section class="commercial-band"><div class="wrap"><p class="eyebrow">{copy.text_010}</p><h2>{copy.text_011}<br />{copy.text_012}</h2><div class="commercial-factors">{factors.map(({title,description,detail},index) => <article><span class="eyebrow">0{index+1}</span><h3>{title}</h3><p>{description}</p><p class="factor-detail">{detail}</p></article>)}</div></div></section>
    <section class="wrap commercial-review"><div><p class="eyebrow">{copy.text_013}</p><h2>{copy.text_014}<br />{copy.text_015}</h2><p>{copy.text_016}</p></div><ul><li>{copy.text_017}</li><li>{copy.text_018}</li><li>{copy.text_019}</li><li>{copy.text_020}</li></ul></section>
    <section class="wrap implementation-section" aria-labelledby="implementation-title"><p class="eyebrow">{copy.text_028}</p><h2 id="implementation-title">{copy.text_029}</h2><p class="solution-intro">{copy.text_030}</p><nav class="implementation-links" aria-label={copy.text_032}>{implementation.stages.map((stage,index)=><a href={`/implementacion/#paso-${index+1}`}><span class="eyebrow" aria-hidden="true">0{index+1}</span><h3>{stage.title}</h3><p>{stage.summary}</p><Icon/></a>)}</nav><a class="text-link" href="/implementacion/">{copy.text_031}<Icon/></a></section>
    <section class="wrap faq-section section"><div><p class="eyebrow">{copy.text_021}</p><h2>{copy.text_022}<br />{copy.text_023}</h2></div><FAQList items={faqs.filter(item => item.pricing)} /></section>
    <section class="wrap solution-callout"><div><p class="eyebrow">{copy.text_024}</p><h2>{copy.text_025}</h2></div><div><p>{copy.text_026}</p><a class="text-link" href="/solicitar-demo/">{copy.text_027} <Icon /></a></div></section>
  </main><Footer />
</Layout>
