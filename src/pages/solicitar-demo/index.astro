---
import pageContent from '../../../content/pages.json';
const copy = pageContent['pages-solicitar-demo-index'];
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppContact from '../../components/WhatsAppContact.astro';
import { solutions } from '../../data/solutions';
import '../../styles/solutions.css';
import '../../styles/commercial.css';
---
<Layout title={copy.seo_title} description={copy.seo_description}>
  <Header />
  <main id="contenido" tabindex="-1">
    <section class="wrap solution-hero">
      <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">{copy.text_001}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.text_002}</span></nav>
      <p class="eyebrow">{copy.text_003}</p>
      <h1>{copy.text_004}<br /><em>{copy.text_005}</em></h1>
      <p class="solution-intro">{copy.text_006}</p>
      <aside class="scope-note"><strong>{copy.text_007}</strong><p>{copy.text_008}</p></aside>
    </section>
    <div class="wrap"><WhatsAppContact /></div>
    <section class="wrap demo-workspace" aria-labelledby="guide-title">
      <div><p class="eyebrow">{copy.text_009}</p><h2 id="guide-title">{copy.text_010}</h2><p>{copy.text_011}</p><div class="demo-steps"><h3>{copy.text_012}</h3><ol><li>{copy.text_013}</li><li>{copy.text_014}</li><li>{copy.text_015}</li></ol></div><noscript><p class="scope-note">{copy.text_016}</p></noscript></div>
      <div class="demo-builder" data-guide-copy={JSON.stringify(copy.guide)} hidden>
        <form id="demo-guide" aria-label={copy.guide.formLabel}>
          <div class="field"><label for="business">{copy.text_017}</label><select id="business" required><option value="">{copy.text_018}</option>{solutions.map(solution => <option value={solution.name}>{solution.name}</option>)}<option>{copy.text_019}</option></select></div>
          <div class="field"><label for="locations">{copy.text_020}</label><select id="locations" required><option value="">{copy.text_021}</option><option>{copy.text_022}</option><option>{copy.text_023}</option><option>{copy.text_024}</option><option>{copy.text_025}</option></select></div>
          <div class="field"><label for="priority">{copy.text_026}</label><select id="priority" required><option value="">{copy.text_027}</option><option>{copy.text_028}</option><option>{copy.text_029}</option><option>{copy.text_030}</option><option>{copy.text_031}</option><option>{copy.text_032}</option><option>{copy.text_033}</option></select></div>
          <p class="local-note">{copy.text_034}</p>
          <div class="guide-actions"><button class="button" type="submit">{copy.text_035}</button><button class="guide-reset" type="reset">{copy.text_036}</button></div>
        </form>
        <section id="guide-result" class="guide-result" aria-labelledby="result-title" hidden><h3 id="result-title" tabindex="-1">{copy.text_037}</h3><p>{copy.text_038}</p><pre id="guide-text"></pre><button id="download-guide" class="button" type="button">{copy.text_039}</button></section>
        <p id="guide-status" role="status" aria-live="polite" aria-atomic="true"></p>
      </div>
    </section>
    <section class="wrap solution-callout"><div><p class="eyebrow">{copy.text_040}</p><h2>{copy.text_041}</h2></div><div><p>{copy.text_042}</p><div class="commercial-links"><a class="text-link" href="/funcionalidades/">{copy.text_043}</a><a class="text-link" href="/precios/">{copy.text_044}</a></div></div></section>
  </main><Footer />
</Layout>
<script>
  const builder = document.querySelector<HTMLElement>('.demo-builder');
  type GuideCopy = { heading: string; businessLabel: string; locationsLabel: string; priorityLabel: string; questionsHeading: string; questions: string[]; disclaimer: string; generatedStatus: string; downloadStatus: string };
  const guideCopy = builder ? JSON.parse(builder.dataset.guideCopy!) as GuideCopy : null;
  const form = document.querySelector<HTMLFormElement>('#demo-guide');
  const business = document.querySelector<HTMLSelectElement>('#business');
  const locations = document.querySelector<HTMLSelectElement>('#locations');
  const priority = document.querySelector<HTMLSelectElement>('#priority');
  const result = document.querySelector<HTMLElement>('#guide-result');
  const text = document.querySelector<HTMLElement>('#guide-text');
  const status = document.querySelector<HTMLElement>('#guide-status');
  function clearResult() {
    if (result) result.hidden = true;
    if (text) text.textContent = '';
    if (status) status.textContent = '';
  }
  if (guideCopy && builder && form && business && locations && priority && result && text && status) {
    builder.hidden = false;
    form.addEventListener('submit', event => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      text.textContent = [
        guideCopy.heading, '',
        `${guideCopy.businessLabel}: ${business.value}`, `${guideCopy.locationsLabel}: ${locations.value}`, `${guideCopy.priorityLabel}: ${priority.value}`, '',
        guideCopy.questionsHeading,
        ...guideCopy.questions.map(question => `- ${question}`), '',
        guideCopy.disclaimer,
      ].join('\n');
      result.hidden = false;
      status.textContent = guideCopy.generatedStatus;
      document.querySelector<HTMLElement>('#result-title')?.focus();
    });
    form.addEventListener('change', clearResult);
    form.addEventListener('reset', () => { clearResult(); business.focus(); });
    document.querySelector('#download-guide')?.addEventListener('click', () => {
      if (!text.textContent) return;
      const url = URL.createObjectURL(new Blob([text.textContent], { type: 'text/plain;charset=utf-8' }));
      const link = document.createElement('a');
      link.href = url; link.download = 'sistematicando-guia-demo.txt';
      document.body.append(link); link.click(); link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      status.textContent = guideCopy.downloadStatus;
    });
  }
</script>
