---
import pageContent from '../../../content/pages.json';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppContact from '../../components/WhatsAppContact.astro';
import { contact } from '../../data/contact';
import '../../styles/solutions.css';
import '../../styles/commercial.css';
import '../../styles/contact.css';
const copy = pageContent['pages-contacto-index'];
const privacyWhatsapp = `https://wa.me/${contact.whatsapp}`;
---
<Layout title={copy.seo_title} description={copy.seo_description}>
  <Header />
  <main id="contenido" tabindex="-1">
    <section class="wrap solution-hero">
      <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">{copy.text_001}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.text_002}</span></nav>
      <p class="eyebrow">{copy.text_003}</p>
      <h1>{copy.text_004}<br /><em>{copy.text_005}</em></h1>
      <p class="solution-intro">{copy.text_006}</p>
      <aside class="scope-note"><strong>{copy.text_007}</strong><p>{copy.text_008}</p></aside>
    </section>
    <div class="wrap"><WhatsAppContact /></div>
    <section class="wrap contact-privacy" aria-labelledby="privacy-contact-heading">
      <div><p class="eyebrow">{copy.text_009}</p><h2 id="privacy-contact-heading">{copy.text_010}</h2><p>{copy.text_011}</p>
        <div class="commercial-links"><a class="text-link privacy-email" href={`mailto:${contact.email}`} aria-describedby="privacy-channel-notice">{copy.text_012}</a><a class="text-link privacy-whatsapp" href={privacyWhatsapp} target="_blank" rel="noopener noreferrer" aria-describedby="privacy-channel-notice">{copy.text_013}</a></div>
        <p id="privacy-channel-notice" class="local-note">{copy.text_020}</p>
      </div>
      <div class="contact-details"><dl>
        <dt>{copy.text_014}</dt><dd>{contact.responsible}</dd>
        <dt>{copy.text_015}</dt><dd>{contact.ruc}</dd>
        <dt>{copy.text_016}</dt><dd>{contact.address}</dd>
        <dt>{copy.text_017}</dt><dd>{contact.email}</dd>
        <dt>{copy.text_018}</dt><dd>{contact.phoneLabel}</dd>
      </dl><a class="text-link" href={contact.privacyPath}>{copy.text_019}</a></div>
    </section>
    <section class="wrap solution-callout"><div><p class="eyebrow">{copy.text_021}</p><h2>{copy.text_022}</h2></div><div><p>{copy.text_023}</p><div class="commercial-links"><a class="text-link" href="/solicitar-demo/">{copy.text_024}</a><a class="text-link" href="/preguntas-frecuentes/">{copy.text_025}</a></div></div></section>
  </main>
  <Footer />
</Layout>
