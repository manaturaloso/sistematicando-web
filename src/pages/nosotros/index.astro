---
import pageContent from '../../../content/pages.json';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { solutions } from '../../data/solutions';
import '../../styles/solutions.css';
import '../../styles/company.css';
const copy=pageContent['pages-nosotros-index'];
---
<Layout title={copy.seo_title} description={copy.seo_description}>
  <Header/><main id="contenido" tabindex="-1">
    <section class="wrap solution-hero"><nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">{copy.text_001}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.text_002}</span></nav><p class="eyebrow">{copy.text_003}</p><h1>{copy.text_004}<br/><em>{copy.text_005}</em></h1><p class="solution-intro">{copy.text_006}</p></section>
    <section class="wrap company-section company-story" aria-labelledby="idea-title"><div><p class="eyebrow">{copy.text_007}</p><h2 id="idea-title">{copy.text_008}</h2></div><div><p>{copy.text_009}</p><p>{copy.text_010}</p></div></section>
    <section class="wrap company-section" aria-labelledby="values-title"><p class="eyebrow">{copy.text_011}</p><h2 id="values-title">{copy.text_012}</h2><div class="company-values">{copy.values.map(value=><article><h3>{value.title}</h3><p>{value.text}</p></article>)}</div></section>
    <section class="wrap company-section" aria-labelledby="sectors-title"><p class="eyebrow">{copy.text_013}</p><h2 id="sectors-title">{copy.text_014}</h2><p class="solution-intro">{copy.text_015}</p><nav class="company-sectors" aria-label={copy.text_016}>{solutions.map(solution=><a href={`/soluciones/${solution.slug}/`}>{solution.name}<Icon/></a>)}</nav></section>
    <section class="wrap solution-callout"><div><p class="eyebrow">{copy.text_017}</p><h2>{copy.text_018}</h2></div><div><p>{copy.text_019}</p><div class="company-links"><a class="text-link" href="/contacto/">{copy.text_020}<Icon/></a><a class="text-link" href="/funcionalidades/">{copy.text_021}<Icon/></a></div></div></section>
  </main><Footer/>
</Layout>
