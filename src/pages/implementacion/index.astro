---
import pageContent from '../../../content/pages.json';
import implementation from '../../../content/implementation.json';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { whatsappUrl } from '../../data/contact';
import '../../styles/solutions.css';
import '../../styles/commercial.css';
const copy=pageContent['pages-implementacion-index'];
---
<Layout title={copy.seo_title} description={copy.seo_description}>
  <Header/><main id="contenido" tabindex="-1">
    <section class="wrap solution-hero"><nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">{copy.text_001}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.text_002}</span></nav><p class="eyebrow">{copy.text_003}</p><h1>{copy.text_004}<br/><em>{copy.text_005}</em></h1><p class="solution-intro">{copy.text_006}</p><aside class="scope-note"><strong>{copy.text_007}</strong><p>{copy.text_008}</p></aside><div class="commercial-links"><a class="button" href="/solicitar-demo/">{copy.text_021}<Icon/></a><a class="text-link" href="/precios/">{copy.text_022}<Icon/></a></div></section>
    <section class="wrap implementation-section" aria-labelledby="stages-title"><p class="eyebrow">{copy.text_009}</p><h2 id="stages-title">{copy.text_010}</h2><ol class="implementation-stages">{implementation.stages.map((stage,index)=><li id={`paso-${index+1}`}><span class="eyebrow" aria-hidden="true">0{index+1}</span><div><h3>{stage.title}</h3><p>{stage.text}</p><div class="implementation-outcome"><h4>{copy.text_011}</h4><p>{stage.outcome}</p></div></div></li>)}</ol></section>
    <section class="commercial-band"><div class="wrap"><p class="eyebrow">{copy.text_012}</p><h2>{copy.text_013}</h2><p class="solution-intro">{copy.text_014}</p><div class="commercial-factors">{implementation.preparation.map(item=><article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>
    <section class="wrap implementation-section" aria-labelledby="responsibilities-title"><p class="eyebrow">{copy.text_015}</p><h2 id="responsibilities-title">{copy.text_016}</h2><p class="solution-intro">{copy.text_017}</p><div class="implementation-responsibilities">{implementation.responsibilities.map(group=><article><h3>{group.title}</h3><ul>{group.items.map(item=><li>{item}</li>)}</ul></article>)}</div></section>
    <section class="wrap solution-callout"><div><p class="eyebrow">{copy.text_018}</p><h2>{copy.text_019}</h2></div><div><p>{copy.text_020}</p><div class="commercial-links"><a class="text-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">{copy.text_023}<Icon/></a><a class="text-link" href="/ayuda/">{copy.text_024}<Icon/></a></div></div></section>
  </main><Footer/>
</Layout>
