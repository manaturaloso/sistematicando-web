---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import SolutionCard from '../../components/SolutionCard.astro';
import { solutions } from '../../data/solutions';
import '../../styles/solutions.css';
export function getStaticPaths() {
  return solutions.map(solution => ({ params: { sector: solution.slug }, props: { solution } }));
}
const { solution } = Astro.props;
const related = solutions.filter(item => item.slug !== solution.slug).slice(0, 3);
---
<Layout title={`${solution.name}: enfoque de gestión · Sistematicando`} description={solution.intro}>
  <Header />
  <main id="contenido">
    <section class="wrap solution-hero sector-hero">
      <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/soluciones/">Soluciones</a><span aria-hidden="true">/</span><span aria-current="page">{solution.name}</span></nav>
      <p class="eyebrow">Sistematicando / {solution.name}</p>
      <h1>{solution.title}</h1>
      <p class="solution-intro">{solution.intro}</p>
      <a class="button" href="#prioridades">Explorar las prioridades <Icon /></a>
    </section>
    <section id="prioridades" class="sector-priorities"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">01 / Lo que importa en tu día a día</p><h2>{solution.focus}</h2></div><p>Necesidades que conviene revisar, sin asumir que todas requieren la misma herramienta.</p></div>
      <div class="needs-grid">{solution.needs.map(([title, text], index) => <article><span class="eyebrow">0{index + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
    </div></section>
    <section class="wrap solution-evaluation"><div><p class="eyebrow">02 / Definamos el alcance</p><h2>Una conversación<br />con las preguntas correctas.</h2><p class="evaluation-areas">Áreas a evaluar: {solution.areas}.</p></div><div><ol class="sector-questions">{solution.questions.map(question => <li>{question}</li>)}</ol><aside class="scope-note" aria-label="Alcance pendiente de verificar"><strong>Qué falta confirmar</strong><p>{solution.limit}</p></aside></div></section>
    <section class="wrap solution-callout"><div><p class="eyebrow">Antes del siguiente paso</p><h2>Tu contexto primero.</h2><p>Una recomendación útil necesita conocer tu operación y verificar el alcance disponible.</p></div><div><p>El canal comercial aún no está habilitado. No recibimos solicitudes ni datos personales desde esta versión.</p><a class="text-link" href="/#conversemos">Preparar una futura demo <Icon /></a></div></section>
    <section class="wrap solutions-section" aria-labelledby="related-title"><p class="eyebrow">Otras formas de trabajar</p><h2 id="related-title">Explora otros enfoques.</h2><div class="solutions-grid related-grid">{related.map(item => <SolutionCard solution={item} />)}</div><a class="text-link" href="/soluciones/">Ver todos los sectores <Icon /></a></section>
  </main>
  <Footer />
</Layout>
