---
import pageContent from '../../../content/pages.json';
const copy = pageContent['pages-soluciones-sector'];
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import SolutionCard from '../../components/SolutionCard.astro';
import { solutions } from '../../data/solutions';
import '../../styles/solutions.css';
export function getStaticPaths() {
  return solutions.map(solution => ({ params: { sector: solution.slug }, props: { solution } }));
}
const { solution } = Astro.props;
const related = solutions.filter(item => item.slug !== solution.slug).slice(0, 3);
---
<Layout title={`${solution.name}: enfoque de gestión · Sistematicando`} description={solution.intro}>
  <Header />
  <main id="contenido">
    <section class="wrap solution-hero sector-hero">
      <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">{copy.text_001}</a><span aria-hidden="true">/</span><a href="/soluciones/">{copy.text_002}</a><span aria-hidden="true">/</span><span aria-current="page">{solution.name}</span></nav>
      <p class="eyebrow">Sistematicando / {solution.name}</p>
      <h1>{solution.title}</h1>
      <p class="solution-intro">{solution.intro}</p>
      <a class="button" href="#prioridades">{copy.text_003} <Icon /></a>
    </section>
    <section id="prioridades" class="sector-priorities"><div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">{copy.text_004}</p><h2>{solution.focus}</h2></div><p>{copy.text_005}</p></div>
      <div class="needs-grid">{solution.needs.map(([title, text], index) => <article><span class="eyebrow">0{index + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
    </div></section>
    <section class="wrap solution-evaluation"><div><p class="eyebrow">{copy.text_006}</p><h2>{copy.text_007}<br />{copy.text_008}</h2><p class="evaluation-areas">Áreas a evaluar: {solution.areas}.</p></div><div><ol class="sector-questions">{solution.questions.map(question => <li>{question}</li>)}</ol><aside class="scope-note" aria-label="Alcance pendiente de verificar"><strong>{copy.text_009}</strong><p>{solution.limit}</p></aside></div></section>
    <section class="wrap solution-callout"><div><p class="eyebrow">{copy.text_010}</p><h2>{copy.text_011}</h2><p>{copy.text_012}</p></div><div><p>{copy.text_013}</p><a class="text-link" href="/solicitar-demo/">{copy.text_014} <Icon /></a></div></section>
    <section class="wrap solutions-section" aria-labelledby="related-title"><p class="eyebrow">{copy.text_015}</p><h2 id="related-title">{copy.text_016}</h2><div class="solutions-grid related-grid">{related.map(item => <SolutionCard solution={item} />)}</div><a class="text-link" href="/soluciones/">{copy.text_017} <Icon /></a></section>
  </main>
  <Footer />
</Layout>
