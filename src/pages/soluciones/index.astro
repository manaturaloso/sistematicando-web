---
import pageContent from '../../../content/pages.json';
const copy = pageContent['pages-soluciones-index'];
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SolutionCard from '../../components/SolutionCard.astro';
import { solutions } from '../../data/solutions';
import '../../styles/solutions.css';
---
<Layout title={copy.seo_title} description={copy.seo_description}>
  <Header />
  <main id="contenido">
    <section class="wrap solution-hero">
      <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">{copy.text_001}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.text_002}</span></nav>
      <p class="eyebrow">{copy.text_003}</p>
      <h1>{copy.text_004}<br /><em>{copy.text_005}</em></h1>
      <p class="solution-intro">{copy.text_006}</p>
      <p class="scope-note">{copy.text_007}</p>
    </section>
    <section class="wrap solutions-section" aria-labelledby="sectors-title">
      <h2 id="sectors-title">{copy.text_008}</h2>
      <div class="solutions-grid">{solutions.map(solution => <SolutionCard solution={solution} />)}</div>
    </section>
    <section class="wrap solution-callout"><div><p class="eyebrow">{copy.text_009}</p><h2>{copy.text_010}<br />{copy.text_011}</h2></div><div><p>{copy.text_012}</p><a class="text-link" href="/solicitar-demo/">{copy.text_013}</a></div></section>
  </main>
  <Footer />
</Layout>
