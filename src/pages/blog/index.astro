---
import pageContent from '../../../content/pages.json';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { articles } from '../../data/articles';
import '../../styles/solutions.css';
import '../../styles/resources.css';
const copy=pageContent['pages-blog-index'];
---
<Layout title={copy.seo_title} description={copy.seo_description}>
  <Header/><main id="contenido" tabindex="-1">
    <section class="wrap solution-hero"><nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">{copy.text_001}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.text_002}</span></nav><p class="eyebrow">{copy.text_003}</p><h1>{copy.text_004}<br/><em>{copy.text_005}</em></h1><p class="solution-intro">{copy.text_006}</p></section>
    <section class="wrap resources-section" aria-labelledby="articles-title"><h2 id="articles-title">{copy.text_007}</h2><div class="guide-grid">{articles.map(article=><article class="guide-card"><p class="eyebrow">{article.category}</p><h3><a href={`/blog/${article.slug}/`}>{article.title}</a></h3><p>{article.intro}</p><a class="text-link" href={`/blog/${article.slug}/`} aria-label={`${copy.text_008}: ${article.title}`}>{copy.text_008}<Icon/></a></article>)}</div><p class="resource-note">{copy.text_009}</p></section>
    <section class="wrap solution-callout"><div><p class="eyebrow">{copy.text_010}</p><h2>{copy.text_011}</h2></div><div><p>{copy.text_012}</p><div class="commercial-links"><a class="text-link" href="/recursos/">{copy.text_013}<Icon/></a><a class="text-link" href="/ayuda/">{copy.text_014}<Icon/></a></div></div></section>
  </main><Footer/>
</Layout>
