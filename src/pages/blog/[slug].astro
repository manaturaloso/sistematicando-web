---
import pageContent from '../../../content/pages.json';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { articles } from '../../data/articles';
import { guides } from '../../data/guides';
import { features } from '../../data/features';
import '../../styles/solutions.css';
import '../../styles/resources.css';
export function getStaticPaths(){return articles.map(article=>({params:{slug:article.slug},props:{article}}));}
const { article }=Astro.props;
const copy=pageContent['pages-blog-article'];
const module=features.find(item=>item.id===article.moduleId)!;
const relatedGuides=guides.filter(guide=>article.guideSlugs.includes(guide.slug));
---
<Layout type="article" title={`${article.title} · Sistematicando`} description={article.intro}>
  <Header/><main id="contenido" tabindex="-1">
    <article class="wrap guide-article">
      <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">{copy.text_001}</a><span aria-hidden="true">/</span><a href="/blog/">{copy.text_002}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.text_003}</span></nav>
      <header class="guide-heading"><p class="eyebrow">{article.category}</p><h1>{article.title}</h1><p class="solution-intro">{article.intro}</p><p class="resource-note">{copy.text_012}</p></header>
      <div class="guide-content"><aside class="guide-toc"><nav aria-label={copy.text_004}><h2>{copy.text_004}</h2><ol>{article.sections.map((section,index)=><li><a href={`#lectura-${index+1}`}>{section.title}</a></li>)}</ol></nav></aside><div class="guide-body">{article.sections.map((section,index)=><section id={`lectura-${index+1}`}><h2>{section.title}</h2>{section.paragraphs.map(paragraph=><p>{paragraph}</p>)}{section.points.length>0&&<ul class="guide-checklist">{section.points.map(point=><li>{point}</li>)}</ul>}</section>)}<section class="guide-takeaway" aria-labelledby="takeaway-title"><h2 id="takeaway-title">{copy.text_005}</h2><p>{article.takeaway}</p></section></div></div>
    </article>
    <section class="wrap resources-section" aria-labelledby="related-title"><p class="eyebrow">{copy.text_006}</p><h2 id="related-title">{copy.text_007}</h2><div class="guide-grid">{relatedGuides.map(guide=><article class="guide-card"><p class="eyebrow">{guide.category}</p><h3><a href={`/recursos/guias/${guide.slug}/`}>{guide.title}</a></h3><p>{guide.intro}</p><a class="text-link" href={`/recursos/guias/${guide.slug}/`} aria-label={`${copy.text_011}: ${guide.title}`}>{copy.text_011}<Icon/></a></article>)}</div><nav class="related-topics" aria-label={copy.text_006}><a href={`/funcionalidades/${module.id}/`}>{copy.text_008}: {module.name}</a></nav><div class="commercial-links"><a class="text-link" href="/blog/">{copy.text_009}<Icon/></a><a class="text-link" href="/solicitar-demo/">{copy.text_010}<Icon/></a></div></section>
  </main><Footer/>
</Layout>
