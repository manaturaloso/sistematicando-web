---
import pageContent from '../../../content/pages.json';
const copy = pageContent['pages-preguntas-frecuentes-index'];
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQList from '../../components/FAQList.astro';
import { faqs, faqCategories } from '../../data/faqs';
import '../../styles/solutions.css';
import '../../styles/resources.css';
---
<Layout title={copy.seo_title} description={copy.seo_description}>
  <Header /><main id="contenido" tabindex="-1">
    <section class="wrap solution-hero"><nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">{copy.text_001}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.text_002}</span></nav><p class="eyebrow">{copy.text_003}</p><h1>{copy.text_004}<br /><em>{copy.text_005}</em></h1><p class="solution-intro">{copy.text_006}</p><nav class="related-topics" aria-label="Temas de preguntas frecuentes">{faqCategories.map(category => <a href={`#${category.id}`}>{category.title}</a>)}</nav></section>
    <div class="wrap faq-directory">{faqCategories.map(category => <section id={category.id} class="faq-category" aria-labelledby={`${category.id}-title`}><h2 id={`${category.id}-title`}>{category.title}</h2><FAQList items={faqs.filter(item => item.category === category.id)} /></section>)}</div>
    <section class="wrap solution-callout"><div><p class="eyebrow">{copy.text_007}</p><h2>{copy.text_008}</h2></div><div><p>{copy.text_009}</p><a class="text-link" href="/solicitar-demo/">{copy.text_010}</a></div></section>
  </main><Footer />
</Layout>
