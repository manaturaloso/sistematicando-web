---
import Icon from './Icon.astro';
import Brand from './Brand.astro';
import navigation from '../../content/navigation.json';
const currentPath = Astro.url.pathname;
---
<a class="skip-link" href="#contenido">{navigation.skipLabel}</a>
<header class="site-header">
  <div class="wrap header-inner">
    <Brand />
    <button class="menu-toggle" type="button" hidden aria-expanded="false" aria-controls="main-nav">{navigation.menuLabel} <span aria-hidden="true">＋</span></button>
    <nav id="main-nav" aria-label="Principal">
      {navigation.header.map(link => <a href={link.href} class:list={[{ 'button small': link.cta }]} aria-current={currentPath === link.href ? 'page' : link.href !== '/' && currentPath.startsWith(link.href) ? 'location' : undefined}>{link.label}{link.cta && <Icon />}</a>)}
    </nav>
  </div>
</header>
<script is:inline>
(() => {
  const button = document.querySelector('.menu-toggle');
  const nav = document.querySelector('#main-nav');
  if (button) { button.hidden = false; button.dataset.ready = 'true'; }
  function closeMenu() { button?.setAttribute('aria-expanded', 'false'); }
  button?.addEventListener('click', () => button.setAttribute('aria-expanded', String(button.getAttribute('aria-expanded') !== 'true')));
  nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') { closeMenu(); button.focus(); }
  });
  matchMedia('(min-width: 900px)').addEventListener('change', closeMenu);
})();
</script>
