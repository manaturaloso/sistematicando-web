---
interface Props { name?: string; }
const { name = 'arrow' } = Astro.props;
const paths: Record<string, string> = {
 arrow: 'M5 19 19 5M5 5h14v14',
 grid: 'M3 3h18v18H3zM9 3v18M9 10h12',
 cup: 'M4 8h12v7a6 6 0 0 1-12 0V8ZM16 9h2a3 3 0 0 1 0 6h-2M3 22h15M7 2v3M12 2v3',
 sparkle: 'M12 2v20M2 12h20M5 5l14 14M5 19 19 5',
 bars: 'M4 20V11M12 20V4M20 20v-6',
 circle: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM12 7v5l3 2',
};
---
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name] ?? paths.arrow} /></svg>
