{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sistematicando-editor-auth",
  "main": "workers/visual-auth.mjs",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "EDITOR_ORIGIN": "",
    "GITHUB_CLIENT_ID": "",
    "VISUAL_WRITES_ENABLED": "false"
  },
  "assets": {
    "directory": "./.editor-dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/auth/*",
      "/editor-api/*",
      "/__visual_editor/*"
    ]
  }
}
