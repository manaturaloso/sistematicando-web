{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sistematicando-web",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "node scripts/build-worker.mjs",
    "watch_dir": [
      "src",
      "content",
      "public"
    ]
  }
}
