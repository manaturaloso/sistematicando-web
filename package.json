    "test:navigation": "node scripts/verify-navigation.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "astro": "7.4.5",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "lighthouse": "13.6.0"
