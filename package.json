{
  "name": "sistematicando-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "docs:features": "node scripts/sync-feature-status.mjs",
    "cms:config": "node scripts/generate-cms-config.mjs",
    "content:check": "node scripts/validate-content.mjs",
    "prebuild": "npm run content:check",
    "audit:a11y": "node scripts/audit-accessibility.mjs",
    "audit:performance": "node scripts/audit-performance.mjs",
    "test:navigation": "node scripts/verify-navigation.mjs",
    "worker:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "worker:dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "test:worker": "node scripts/verify-worker.mjs",
    "test:site": "node scripts/verify-site.mjs",
    "test:ci": "node scripts/ci-quality.mjs",
    "test:brand": "node scripts/verify-brand.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "review:visual": "node scripts/review-visual.mjs",
    "test:compatibility": "node scripts/verify-compatibility.mjs",
    "editor:build": "node scripts/build-hosted-editor.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "astro": "7.4.5",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "lighthouse": "13.6.0",
    "wrangler": "4.157.0"
  }
}
